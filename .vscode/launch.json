{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Windows",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "windows",
      "flutterMode": "debug"
    },
    {
      "name": "Debug Android",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["-d", "android"],
      "flutterMode": "debug"
    },
    {
      "name": "Profile Windows",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "windows",
      "flutterMode": "profile"
    },
    {
      "name": "Profile Android",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["-d", "android"],
      "flutterMode": "profile"
    },
    {
      "name": "Release Windows",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "windows",
      "flutterMode": "release"
    },
    {
      "name": "Release Android",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["-d", "android"],
      "flutterMode": "release"
    }
  ]
}
